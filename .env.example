# Строка подключения к PostgreSQL
DATABASE_URL=postgresql+psycopg://portfolio:portfolio@localhost:5432/portfolio

# Каталоги данных
DATA_RAW_DIR=data/raw
DATA_INPUT_DIR=data/input

# Ставка НДФЛ по умолчанию (для оценки, не для восстановления gross — спека 3.2)
TAX_RATE=0.13

# Пороги сверки (спека 5.2): деньги — до копейки, бумаги — точно
RECONCILE_CASH_TOLERANCE=0.01
RECONCILE_QUANTITY_TOLERANCE=0

# Мягкий допуск на деньги для отчётов с займом бумаг (A-27). Расхождение в его
# пределах не останавливает импорт, но печатается и попадает во «Входящие»:
# остаток накопителен, и растущая из месяца в месяц разница — уже ошибка
# разбора, а не неточность займа. Ноль возвращает строгую сверку.
RECONCILE_LOAN_TOLERANCE=1.00

# Хранилище параллельного трека по облигациям: снапшоты ISS, кеш, SQLite.
# Отдельно от боевой БД по построению (docs/PARALLEL-TRACK.md).
BONDLAB_DIR=data/bondlab
