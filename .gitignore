.env
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Сырьё брокера резервируется отдельно от git (спека 5.8)
data/raw/*
!data/raw/.gitkeep

# Снапшоты ISS, кеш и SQLite параллельного трека: данные, а не код.
# Эталонный набор лежит в tests/fixtures/iss/ и в git входит.
data/bondlab/

# Ключ к деобезличиванию отчётов: хранится рядом с исходными отчётами, не в git
.anonymize-mapping.json

# Локальная БД прогона: внутри настоящие суммы и названия бумаг.
# Файл создаётся в текущем каталоге, а прогон идёт из корня репозитория —
# без этого правила журнал попадёт под `git add .` (спека: данные не в git).
*.db
*.sqlite
*.sqlite3
